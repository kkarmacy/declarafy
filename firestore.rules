// firestore.rules — DeclaraFY
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'christian@declarafy.com';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.plan == 'basico';
      allow update: if (isOwner(uid) || isAdmin())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'uid']);
      allow delete: if false;
    }

    match /users/{uid}/kv/{key} {
      allow read, write: if isOwner(uid);
    }

    match /historial/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /casos/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Suggestions are shared for reading, but creation is bound to the
    // authenticated author and restricted to a small, explicit schema.
    match /sugerencias/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'uid', 'email', 'nombre', 'texto', 'estado', 'createdAt'
                    ])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 2000
                    && request.resource.data.estado == 'pendiente';
      allow update, delete: if isAdmin();
    }

    match /api_keys/{keyId} {
      allow read, write: if false;
    }

    match /radar_normativo/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /rate_limits/{docId} {
      allow read, write: if false;
    }
    match /exports/{docId} {
      allow read, write: if false;
    }
    match /whatsapp_alerts/{docId} {
      allow read, write: if false;
    }
  }
}
